# Required on first startup when no ADMIN user is present. Use a long unique password.
ACUITY_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional: comma-separated browser origins if the frontend is hosted separately.
# APP_ORIGIN=https://example.com

# Optional: set to true only behind HTTPS in production.
COOKIE_SECURE=true

# Hostinger supplies PORT automatically. Locally, the default is 3000.

# Optional paths, useful only for isolated tests. Production defaults are acuity.db
# and private_uploads in the application root.
# ACUITY_DB_PATH=/absolute/path/to/acuity.db
# ACUITY_UPLOADS_PATH=/absolute/path/to/private_uploads
